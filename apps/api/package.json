{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./routes": {
      "types": "./src/routes/index.ts",
      "default": "./src/routes/index.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:vinext": "wrangler dev",
    "deploy": "wrangler deploy",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:fresh": "node scripts/db-migrate.mjs --fresh",
    "db:seed": "node scripts/db-migrate.mjs --seed-only"
  },
  "dependencies": {
    "@3lineas/groovepack": "^1.3.0",
    "@hono/valibot-validator": "^0.6.1",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@repo/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^12.11.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.164.0"
  }
}
