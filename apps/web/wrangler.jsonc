{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "development",
    "NEXT_PUBLIC_GROOVEPACK_LOCALE": "es"
  },
  "services": [
    {
      "binding": "API",
      "service": "api"
    }
  ],
  "observability": {
    "enabled": true
  }
}
